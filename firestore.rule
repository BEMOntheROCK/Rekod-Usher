rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /rekod/{rekodId} {
      // Sesiapa sahaja boleh menghantar rekod baru (borang usher)
      allow create: if true;

      // Sesiapa sahaja boleh membaca, mengemaskini, dan memadam rekod
      // (kerana admin.html tiada log masuk / auth)
      allow read, update, delete: if true;
    }

    // Tolak semua akses kepada koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}